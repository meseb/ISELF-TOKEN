# Thirdweb Configuration
# Get your API key from: https://thirdweb.com/dashboard/settings

# Your thirdweb secret key (required for deployment)
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# Private key of the wallet that will deploy the contract (without 0x prefix)
# IMPORTANT: Keep this secret! Never commit this to git!
# NOTE: All tokens will be minted to this wallet address upon deployment
PRIVATE_KEY=your_private_key_here

# Network to deploy to (options: mumbai, polygon, ethereum, goerli, sepolia, etc.)
NETWORK=mumbai

# Optional: Custom RPC URL (if not using thirdweb's default)
# RPC_URL=https://your-custom-rpc-url

# Optional: Gas settings
# GAS_LIMIT=3000000
# GAS_PRICE=50
